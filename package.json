{
  "name": "mcp-libraryofcongress",
  "version": "2.1.2",
  "description": "MCP server for the Library of Congress. Search inside digitised newspaper pages, browse the catalogue by format, and read records and collections. No API key required.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "library-of-congress",
    "loc",
    "chronicling-america",
    "newspapers",
    "full-text-search",
    "archives"
  ],
  "homepage": "https://github.com/smeet666/mcp-libraryofcongress#readme",
  "bugs": {
    "url": "https://github.com/smeet666/mcp-libraryofcongress/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/smeet666"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smeet666/mcp-libraryofcongress.git"
  },
  "license": "MIT",
  "author": "Damien Bouissou",
  "type": "module",
  "bin": {
    "mcp-libraryofcongress": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "types": "./dist/loc/client.d.ts",
      "import": "./dist/loc/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "mcpName": "io.github.smeet666/mcp-libraryofcongress",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:live": "vitest run test/live --testTimeout=120000",
    "build:fixtures": "node scripts/build-fixtures.mjs",
    "format": "biome check --write && prettier --write \"**/*.{md,yml}\"",
    "check": "biome ci && prettier --check \"**/*.{md,yml}\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^22.18.0",
    "prettier": "3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
